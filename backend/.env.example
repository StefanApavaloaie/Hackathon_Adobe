# Copy to backend/.env. Never commit real values.

# Must match the frontend's URL exactly. Use the Vercel URL in production.
FRONTEND_ORIGIN=http://localhost:5173
# Base URL for links in emails. Use the Render URL in production.
PUBLIC_API_URL=http://127.0.0.1:8000

# Lets protected routes through until the real login check exists.
# Local development only. Never set this on Render.
ALLOW_DEV_AUTH=true

# Supabase: Project Settings > API. These are server-side secrets.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# "saved" replays saved responses, and "live" spends tokens from the shared daily allowance.
LLM_MODE=saved

# Stripe: test mode only. The backend refuses to start with any other key type.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend
RESEND_API_KEY=
# Sender address on your verified domain, for example Win-back <hello@yourdomain.com>
EMAIL_FROM=
# Comma-separated list. Real email may only be sent to these addresses.
RECIPIENT_ALLOWLIST=
